APP_NAME="Travel With You"
APP_ENV=local
# Generate with: php artisan key:generate (never commit the real value)
APP_KEY=
# Production: set APP_ENV=production and APP_DEBUG=false.
APP_DEBUG=true
APP_URL=http://localhost
ADMIN_NAME="Travel With You Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_MFA_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Production (HTTPS): set SESSION_SECURE_COOKIE=true and SESSION_ENCRYPT=true.
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Keep false to prevent private files from being served through Laravel.
FILESYSTEM_LOCAL_SERVE=false
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use "resend" for live email; the default "log" is safe for local development.
MAIL_MAILER=log
# Mail is used for booking confirmations, enquiries, sign-in codes and verification.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TRAVEL_TAX_RATE=0.07
TRAVEL_STACK_PROMO_ON_DEALS=true

PAYMENT_VISA_ENABLED=true
PAYMENT_MC_ENABLED=true
PAYMENT_AMEX_ENABLED=true
PAYMENT_PAYPAL_ENABLED=true
PAYMENT_BANK_ENABLED=true

COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_HOURS=
